{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kakomonn-count-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-07-17",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/v6/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LEARNING_STATE",
        "class_name": "StabilityState"
      }
    ]
  },
  "exports": {
    "StabilityState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
